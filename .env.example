# --- Backend (main application) API ---
# Base URL of your backend REST API, INCLUDING the /api/v1 prefix. This
# service never talks to a database directly - every tool call proxies
# through here with the caller's own token.
MAIN_APP_API_URL=https://devapp.insureops.io/api/v1
MAIN_APP_API_TIMEOUT_MS=10000

# --- Auth ---
# This backend issues its own HS256-signed access tokens directly from
# POST /auth/login (email+password) - there is no external IdP and no JWKS
# endpoint to verify signatures against, and tokens carry no iss/aud claims.
# Instead of verifying signatures locally, this server validates every
# inbound token against the backend's own GET /auth/me/permissions endpoint
# (see src/auth/middleware.ts) - if the backend accepts the token, it's
# real, and we get a live, current permission list back with it. No
# additional auth env vars are required beyond MAIN_APP_API_URL above.

# --- Diff lifecycle ---
# How long (seconds) a computed diffId / staged change request stays valid
# before apply/create refuses it. Diffs and change requests are persisted
# to the local SQLite file at DB_PATH (the backend has no equivalent
# concept) - see src/server/tools/diffStore.ts.
DIFF_TTL_SECONDS=900

# --- Storage ---
# Path to the local SQLite file backing diffs/change-requests (the audit
# trail of staged and applied commission-schedule edits). Survives process
# restarts. This is a single local file - not shared across instances, so
# it is only appropriate for a single-instance deployment (see caveat in
# src/server/tools/diffStore.ts).
DB_PATH=./data/commission-sync.sqlite

# --- Service config ---
PORT=3000
ALLOWED_ORIGINS=https://claude.ai,https://your-app.example.com
NODE_ENV=development
LOG_LEVEL=info

# --- Self-service setup page (GET/POST /setup) ---
# The public https:// base URL brokers reach this server at, used to render
# the correct MCP url in the config snippet /setup generates. If unset,
# it's derived from the request itself (via `trust proxy`) - set this
# explicitly once you have a real domain, especially if this runs behind a
# proxy that doesn't set X-Forwarded-Proto/Host correctly.
# PUBLIC_URL=https://mcp.your-domain.example.com

# --- TESTING ONLY - never set these outside local development ---
# When DISABLE_AUTH=true, token verification is skipped entirely and every
# request is treated as a fixed dev session built from DEV_TENANT_ID/
# DEV_USER_ID/DEV_ROLES/DEV_PERMISSIONS/DEV_ACCESS_TOKEN below. The server
# refuses to start with this set if NODE_ENV=production. Use this only to
# explore tools locally (e.g. with MCP Inspector) before you have real
# credentials wired up.
# DISABLE_AUTH=true
# DEV_TENANT_ID=dev-tenant
# DEV_USER_ID=dev-user
# DEV_ROLES=tenant_admin
# DEV_PERMISSIONS=commissions:schedules:view,commissions:schedules:create,commissions:schedules:update,commissions:schedules:delete,settings:insurer:view,settings:products:view,settings:plans:view
# DEV_ACCESS_TOKEN=dev-mode-no-token
